{
  "name": "lagrange-fin-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LagrangeFinance の数式を読みながら金融モデルをブラウザで動かす教材（初版：円OISカーブと7年OIS）",
  "scripts": {
    "dev": "node scripts/check-port.mjs 8080 && vite",
    "api": "node scripts/run-r.mjs server/server.R --port 8787",
    "build": "tsc -b && vite build",
    "preview": "node scripts/check-port.mjs 8080 && vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "golden": "node scripts/run-r.mjs golden/generate_golden.R",
    "reconcile": "node scripts/run-r.mjs reconciliation/reconcile_tona_ois.R",
    "lan": "npm run build && node scripts/check-port.mjs 8080 0.0.0.0 && node scripts/run-r.mjs server/server.R --host 0.0.0.0 --port 8080 --static dist",
    "reconcile:asw": "node scripts/run-r.mjs reconciliation/asw/reconcile_asw_jpy.R && node scripts/run-r.mjs reconciliation/asw/reconcile_yen_asw.R",
    "snapshot:asw": "node scripts/run-r.mjs scripts/asw/snapshot_curie_demo.R"
  },
  "dependencies": {
    "katex": "0.19.1",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
